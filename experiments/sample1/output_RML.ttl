

    # RML Mapping

    @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
    @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
    @prefix ex: <http://example.org/> .

    ex:PersonMapping a rml:Mapping .
    ex:PersonMapping rml:logicalSource [
        rml:source [
            rml:sourceFormat "csv" ;
            rml:referenceFormulation <http://reference.data.gov/definitions/csv/>
        ] ;
        rml:sparqlEndpoint "http://example.org/sparql"
    ] ;
    rml:triplesMap [
        rml:type "TriplesMap" ;
        rml:logicalSource ex:PersonMapping ;
        rml:subjectMap [
            rml:template "http://example.org/person/{id}" ;
            rr:termType rdf:IRI
        ] ;
        rml:predicateObjectMap [
            rml:predicate ex:hasName ;
            rml:objectMap [
                rr:column "name" ;
                rr:termType rdf:PlainLiteral ;
                rr:language "en"
            ]
        ] ;
        rml:predicateObjectMap [
            rml:predicate ex:hasAge ;
            rml:objectMap [
                rr:column "age" ;
                rr:termType rdf:Integer
            ]
        ]
    ] .

    ex:Person a rdfs:Class .
    ex:hasName a rdf:Property ;
        rdfs:domain ex:Person ;
        rdfs:range rdfs:Literal .